{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    ".output/",
    ".wxt/",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "app/shared/vendor/",
    "spikes/",
    "verification/",
    "app/public/THIRD_PARTY_NOTICES.md",
    "app/tests/fixtures/"
  ]
}
