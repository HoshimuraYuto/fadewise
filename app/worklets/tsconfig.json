{
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["audioworklet"],
    "target": "ES2022",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["**/*.mts"]
}
