const LANGS = Object.keys(DICT) as Lang[];
const isLang = (x: unknown): x is Lang => LANGS.includes(x as Lang);

function resolveLang(pref: unknown, uiLang: unknown): Lang {
  if (isLang(pref)) return pref;

  return /^ja(\b|[-_])/i.test(typeof uiLang === 'string' ? uiLang : '') ? 'ja' : 'en';
}

let lang: Lang = 'en';

const setLang = (l: unknown): void => {
  lang = isLang(l) ? l : 'en';
};

const getLang = (): Lang => lang;

const lookup = (l: Lang, key: string): string | undefined => (Object.hasOwn(DICT[l], key) ? DICT[l][key] : undefined);

function t(key: string, vars?: Vars): string {
  const s = lookup(lang, key) ?? lookup('en', key) ?? key;

  return vars ? s.replace(/\{(\w+)\}/g, (m, k: string) => (k in vars ? String(vars[k]) : m)) : s;
}

function browserLang(): string {
  try {
    return chrome.i18n.getUILanguage();
  } catch {
    return typeof navigator !== 'undefined' ? navigator.language : 'en';
  }
}

const uiLanguageOf = (settings: unknown): unknown =>
  settings && typeof settings === 'object' ? (settings as { uiLanguage?: unknown }).uiLanguage : undefined;

function applyI18n(doc: Document): void {
  doc.documentElement.lang = lang;
  for (const e of doc.querySelectorAll<HTMLElement>('[data-i18n]')) e.textContent = t(e.dataset.i18n ?? '');

  for (const e of doc.querySelectorAll<HTMLInputElement>('[data-placeholder-key]')) {
    e.placeholder = t(e.dataset.placeholderKey ?? '');
    e.setAttribute('aria-label', e.placeholder);
  }

  const key = doc.documentElement.dataset.titleKey;
  doc.title = key ? `${t(key)} – ${EXTENSION_NAME}` : EXTENSION_NAME;
  for (const e of doc.querySelectorAll('.appName')) e.textContent = EXTENSION_NAME;
}

async function initLang(onChange?: () => void): Promise<void> {
  const { settings } = await chrome.storage.local.get('settings');
  setLang(resolveLang(uiLanguageOf(settings), browserLang()));
  chrome.storage.onChanged.addListener((changes, area) => {
    const change = 'settings' in changes ? changes.settings : undefined;
    if (area !== 'local' || !change) return;
    const next = resolveLang(uiLanguageOf(change.newValue), browserLang());

    if (next !== lang) {
      setLang(next);
      if (onChange) onChange();
    }
  });
}

export { DICT, LANGS, resolveLang, setLang, getLang, t, applyI18n, initLang };
